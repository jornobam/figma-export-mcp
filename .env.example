# Read-only Figma token with file_content:read.
FIGMA_TOKEN=figd_example_only
# OAuth token for one Yandex Disk account.
YANDEX_DISK_TOKEN=y0_example_only
# Optional. Defaults to the OS application-data directory.
FIGMA_EXPORT_STATE_DIR=
YANDEX_DISK_ROOT=/AI Exports
LOG_LEVEL=info
FIGMA_API_BASE_URL=https://api.figma.com
YANDEX_DISK_API_BASE_URL=https://cloud-api.yandex.net/v1/disk
FIGMA_EXPORT_CONCURRENCY=4
FIGMA_EXPORT_MAX_ITEMS=5000
FIGMA_EXPORT_MAX_FILE_BYTES=104857600
FIGMA_EXPORT_MAX_TEMP_BYTES=10737418240
